<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:MaterialDesignThemes.Wpf.Converters"
                    xmlns:convertersInternal="clr-namespace:MaterialDesignThemes.Wpf.Converters.Internal"
                    xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ScrollBar.xaml" />
    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ScrollViewer.xaml" />
    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ValidationErrorTemplate.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style TargetType="{x:Type wpf:Carousel}">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="{Binding RelativeSource={RelativeSource AncestorType={x:Type wpf:Carousel}}, Path=Orientation}"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type wpf:Carousel}">
          <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
            <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
              <Grid.Resources>
                <Style x:Key="CarouselButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                  <Setter Property="Opacity" Value=".7"/>
                  <Setter Property="Visibility" Value="Hidden"/>
                </Style>
              </Grid.Resources>

              <Button Margin="5,0"
                      HorizontalAlignment="Left"
                      Panel.ZIndex="1"
                      Content="{wpf:PackIcon Kind=ArrowLeftBold}"
                      Command="{x:Static wpf:Carousel.TransitionBackwardCommand}">
                <Button.Style>
                  <Style BasedOn="{StaticResource CarouselButtonStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsDefaultButtonVisible}" Value="True"/>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Orientation}" Value="Horizontal"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                          <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger.Setters>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button Margin="5,0"
                      HorizontalAlignment="Right"
                      Panel.ZIndex="1"
                      Content="{wpf:PackIcon Kind=ArrowRightBold}"
                      Command="{x:Static wpf:Carousel.TransitionForwardCommand}">
                <Button.Style>
                  <Style BasedOn="{StaticResource CarouselButtonStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsDefaultButtonVisible}" Value="True"/>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Orientation}" Value="Horizontal"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                          <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger.Setters>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>

              <Button Margin="0,5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Panel.ZIndex="1"
                      Content="{wpf:PackIcon Kind=ArrowUpBold}"
                      Command="{x:Static wpf:Carousel.TransitionBackwardCommand}">
                <Button.Style>
                  <Style BasedOn="{StaticResource CarouselButtonStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsDefaultButtonVisible}" Value="True"/>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Orientation}" Value="Vertical"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                          <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger.Setters>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>

              <Button Margin="5,0"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Center"
                      Panel.ZIndex="1"
                      Content="{wpf:PackIcon Kind=ArrowDownBold}"
                      Command="{x:Static wpf:Carousel.TransitionForwardCommand}">
                <Button.Style>
                  <Style BasedOn="{StaticResource CarouselButtonStyle}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsDefaultButtonVisible}" Value="True"/>
                          <Condition Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Orientation}" Value="Vertical"/>
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                          <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger.Setters>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <ScrollViewer Style="{x:Null}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" x:Name="ScrollViewer">
                <ItemsPresenter/>
              </ScrollViewer>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style TargetType="{x:Type wpf:CarouselItem}">
    <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type wpf:Carousel}}, Path=ActualHeight}"/>
    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type wpf:Carousel}}, Path=ActualWidth}"/>
    <Setter Property="Content">
      <Setter.Value>
        <ContentPresenter Content="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Content}"
                          ContentTemplate="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Content}"/>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
